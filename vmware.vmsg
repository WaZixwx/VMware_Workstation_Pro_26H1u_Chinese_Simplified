msg.guestos.backward = "在创建配置的软件版本 %1$s 中，客户机操作系统设置仅供参考。在此版本中，正确配置和性能需要这些设置。|0A配置将变量 `hint.guestOS' 定义为 `%2$s'。请确保此值反映您运行的客户机操作系统。|0A选择 %3$s 更新配置文件。稍后需要保存该文件。|0A选择 %4$s 在不更新的情况下继续。|0A"
msg.guestos.badArch = "此虚拟机无法启动，因为它需要计算机架构 %1$s，而此计算机架构主机 %2$s 不支持该架构。请参阅知识库文章 84273。|0A"
msg.guestos.badname = "不支持客户机操作系统 '%1$s'。|0A请在虚拟机配置的 %3$s 选项卡中的 %2$s 页面上选择客户机操作系统。|0A"
msg.guestos.bootcamp = "这是您首次在 %1$s 中使用 Boot Camp 分区。|0A首次使用时，Microsoft Windows 可能需要一些时间才能发现鼠标和其他虚拟硬件。|0A|0A在某些系统上，初始启动时可能无法检测到鼠标。要启用鼠标，请断开并重新启动虚拟机。|0A|0A系统可能会要求您重新激活 Windows。为获得最佳效果，请在重新激活之前安装 %2$s。|0A|0A要安装 %3$s，请等待 Windows 完成启动，然后选择 %4$s > %5$s 并按照说明操作。|0A"
msg.guestos.noname = "配置文件未指定客户机操作系统。|0A请在“虚拟机设置”的 %2$s 选项卡中的 %1$s 页面上选择客户机操作系统。|0A"
msg.gui.cannotReconnect = "无法连接设备。此虚拟机将 %1$s 配置为客户端设备。请手动重新连接设备。|0A"
msg.gui.cannotchangedir = "无法将目录更改为 %1$s：%2$s|0A"
msg.gui.noTools = "没有可用的 %1$s 包。此客户机操作系统没有可用的 %2$s 包。|0A"
msg.gui.noToolsForOther = "没有可用的 %1$s 包。客户机操作系统 |22%3$s|22 没有可用的 %2$s 包。请检查虚拟机配置，确保正在运行的客户机操作系统在列表中。|0A"
msg.gui.toolsNoDevice = "此虚拟机未配置 %1$s 驱动器。虚拟机必须配置 %2$s 驱动器，此选项才能正常工作。|0A"
