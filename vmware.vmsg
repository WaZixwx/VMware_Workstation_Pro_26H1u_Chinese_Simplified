msg.hbacommon.hotremove.notarget = "存储设备不存在。"
msg.hbacommon.locklost = "丢失了 '%1$s' 的保护锁，可能是由于底层存储问题。|0A如果此虚拟机已配置为高可用性，请确保它在单击“确定”之前已在其他主机上运行。|0A"
msg.hbacommon.outofspace = "虚拟磁盘 '%1$s' 没有更多空间。如果您释放相应卷上的磁盘空间，然后单击 %2$s，可以继续此会话。单击 %3$s 结束会话。|0A"
